#!/usr/bin/env bash
set -euo pipefail

HD_VERSION="0.7.2"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
LAYOUT_DIR="${HD_LAYOUT_DIR:-$CONFIG_HOME/herdr/layouts}"
DEFAULT_LAYOUT="${HD_DEFAULT_LAYOUT:-dev}"

log()  { printf '[hd] %s\n' "$*"; }
warn() { printf '[hd] WARN: %s\n' "$*" >&2; }
die()  { printf '[hd] ERROR: %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "Missing dependency: $1"; }
require_deps() { need git; need jq; need python3; need herdr; }

validate_layout_name() {
  local name="$1"
  case "$name" in
    ''|.|..|*/*|*\\*|*[!A-Za-z0-9._-]*) die "Invalid layout name: $name" ;;
  esac
}

global_layout_file() {
  validate_layout_name "$1"
  printf '%s/%s.json\n' "$LAYOUT_DIR" "$1"
}

primary_repo_root() {
  local worktrees primary
  worktrees="$(git_worktrees_json)"
  primary="$(primary_worktree_path "$worktrees")"
  [[ -n "$primary" ]] || die "Could not determine primary Git worktree"
  printf '%s\n' "$primary"
}

local_layout_file() {
  local name="$1" primary
  validate_layout_name "$name"
  primary="$(primary_repo_root)"
  printf '%s/.herdr/layouts/%s.json\n' "$primary" "$name"
}

resolve_layout_file() {
  local name="$1" local_file global_file
  validate_layout_name "$name"
  local_file="$(local_layout_file "$name")"
  global_file="$(global_layout_file "$name")"

  if [[ -f "$local_file" ]]; then
    printf '%s\n' "$local_file"
  else
    printf '%s\n' "$global_file"
  fi
}

validate_layout_file() {
  local file="$1"
  [[ -f "$file" ]] || die "Layout not found: $file"
  [[ -r "$file" ]] || die "Layout is not readable: $file"
  jq -e 'type == "object" and (.type == "pane" or .type == "split")' "$file" >/dev/null 2>&1 \
    || die "Invalid layout JSON/root: $file"
}

validate_branch_name() {
  git check-ref-format --branch "$1" >/dev/null 2>&1 || die "Invalid branch name: $1"
}

git_root() { git rev-parse --show-toplevel 2>/dev/null; }

socket_path() {
  if [[ -n "${HERDR_SOCKET_PATH:-}" ]]; then
    printf '%s\n' "$HERDR_SOCKET_PATH"
  elif [[ -n "${HERDR_SESSION:-}" && "${HERDR_SESSION}" != "default" ]]; then
    printf '%s/herdr/sessions/%s/herdr.sock\n' "$CONFIG_HOME" "$HERDR_SESSION"
  else
    printf '%s/herdr/herdr.sock\n' "$CONFIG_HOME"
  fi
}

herdr_api() {
  local sock
  sock="$(socket_path)"
  [[ -S "$sock" ]] || die "Herdr socket not found: $sock"

  python3 -c '
import socket, sys
path = sys.argv[1]
request = sys.stdin.read().strip()
if not request:
    print("empty Herdr request", file=sys.stderr)
    raise SystemExit(1)
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(10)
try:
    s.connect(path)
    s.sendall(request.encode() + b"\n")
    data = b""
    while b"\n" not in data:
        chunk = s.recv(65536)
        if not chunk:
            raise RuntimeError("Herdr socket closed before a full response")
        data += chunk
    sys.stdout.write(data.split(b"\n", 1)[0].decode() + "\n")
except Exception as exc:
    print(f"Herdr socket error: {exc}", file=sys.stderr)
    raise SystemExit(1)
finally:
    s.close()
' "$sock" || die "Herdr socket request failed: $sock"
}

json_check_error() {
  local response="$1" context="$2"
  if ! printf '%s\n' "$response" | jq -e . >/dev/null 2>&1; then
    printf '[hd] ERROR: %s returned invalid JSON\n' "$context" >&2
    printf '%s\n' "$response" >&2
    return 1
  fi
  if printf '%s\n' "$response" | jq -e '.error != null' >/dev/null 2>&1; then
    printf '[hd] ERROR: %s failed\n' "$context" >&2
    printf '%s\n' "$response" | jq '.error' >&2
    return 1
  fi
}

herdr_json() {
  local context="$1"
  shift
  local response

  if ! response="$(herdr "$@")"; then
    printf '[hd] ERROR: %s command failed\n' "$context" >&2
    return 1
  fi

  json_check_error "$response" "$context" || return 1
  printf '%s\n' "$response"
}

workspace_list_json() {
  local response
  response="$(herdr_json "workspace.list" workspace list)" || return 1
  printf '%s\n' "$response" | jq -e '.result.workspaces | type == "array"' >/dev/null 2>&1 || {
    warn "Unexpected workspace.list response schema"
    printf '%s\n' "$response" | jq >&2
    return 1
  }
  printf '%s\n' "$response"
}

pane_list_json() {
  local response
  response="$(herdr_json "pane.list" pane list)" || return 1
  printf '%s\n' "$response" | jq -e '.result.panes | type == "array"' >/dev/null 2>&1 || {
    warn "Unexpected pane.list response schema"
    printf '%s\n' "$response" | jq >&2
    return 1
  }
  printf '%s\n' "$response"
}

find_workspace_id_by_cwd() {
  local data="$1" cwd="$2"
  printf '%s\n' "$data" | jq -r --arg cwd "$cwd" '
    .result.workspaces
    | map(select((.cwd // "") == $cwd))
    | .[0].workspace_id // empty
  '
}

git_worktrees_json() {
  git worktree list --porcelain -z | python3 -c '
import json, sys
raw = sys.stdin.buffer.read().split(b"\0")
items, cur = [], {}
for token in raw:
    if token == b"":
        if cur:
            items.append(cur)
            cur = {}
        continue
    text = token.decode("utf-8", "surrogateescape")
    if text.startswith("worktree "):
        cur["path"] = text[9:]
    elif text.startswith("branch refs/heads/"):
        cur["branch"] = text[18:]
    elif text == "detached":
        cur["branch"] = "(detached)"
    elif text == "bare":
        cur["bare"] = True
print(json.dumps(items, ensure_ascii=False))
'
}

primary_worktree_path() {
  local data="${1:-$(git_worktrees_json)}"
  printf '%s\n' "$data" | jq -r '.[0].path // empty'
}

worktree_path_for_branch() {
  local data="$1" branch="$2"
  printf '%s\n' "$data" | jq -r --arg branch "$branch" '
    map(select((.branch // "") == $branch)) | .[0].path // empty
  '
}

worktree_is_primary() {
  local data="$1" path="$2" primary
  primary="$(primary_worktree_path "$data")"
  [[ -n "$primary" && "$path" == "$primary" ]]
}

apply_layout() {
  local tab_id="$1" cwd="$2" layout_name="$3"
  local file root request response
  file="$(resolve_layout_file "$layout_name")"
  validate_layout_file "$file"

  root="$(jq --arg cwd "$cwd" '
    walk(
      if type == "object" and .type? == "pane"
      then .cwd = $cwd | del(.pane_id)
      else .
      end
    )
  ' "$file")" || die "Failed to prepare layout: $file"

  request="$(jq -nc \
    --arg tab "$tab_id" \
    --arg label "$layout_name" \
    --argjson root "$root" \
    '{id:"hd-layout-apply",method:"layout.apply",params:{tab_id:$tab,tab_label:$label,focus:true,root:$root}}')" \
    || die "Failed to build layout.apply request"

  log "Applying layout '$layout_name' → $cwd"
  response="$(printf '%s\n' "$request" | herdr_api)"
  json_check_error "$response" "layout.apply"
}

save_layout() {
  local name="${1:-$DEFAULT_LAYOUT}" file request response root tmp
  file="$(global_layout_file "$name")"
  mkdir -p "$LAYOUT_DIR"

  if [[ -n "${HERDR_PANE_ID:-}" ]]; then
    request="$(jq -nc --arg pane "$HERDR_PANE_ID" '{id:"hd-layout-export",method:"layout.export",params:{pane_id:$pane}}')"
  else
    request='{"id":"hd-layout-export","method":"layout.export","params":{}}'
  fi

  log "Exporting current layout as '$name'"
  response="$(printf '%s\n' "$request" | herdr_api)"
  json_check_error "$response" "layout.export" || exit 1
  root="$(printf '%s\n' "$response" | jq -c '(.result.layout.root // .result.root // empty)')"

  if [[ -z "$root" ]]; then
    warn "Could not find layout root"
    warn "Expected .result.layout.root or .result.root"
    printf '%s\n' "$response" | jq >&2
    exit 1
  fi

  tmp="$(mktemp "$LAYOUT_DIR/.${name}.XXXXXX")" || die "Could not create temporary layout file"
  trap 'rm -f "$tmp"' EXIT
  printf '%s\n' "$root" | jq '
    walk(
      if type == "object" and .type? == "pane"
      then .cwd = env.HOME | del(.pane_id)
      else .
      end
    )
  ' > "$tmp" || die "Failed to serialize layout"
  validate_layout_file "$tmp"
  mv -f "$tmp" "$file"
  trap - EXIT

  log "Saved: $file"
  jq . "$file"
}

ensure_herdr_gitignore() {
  local primary="$1" gitignore="$primary/.gitignore"

  if [[ -f "$gitignore" ]] && grep -Eq '^[[:space:]]*/?\.herdr/?[[:space:]]*$' "$gitignore"; then
    return
  fi

  if [[ -s "$gitignore" ]]; then
    if [[ "$(tail -c 1 "$gitignore" | wc -l | tr -d '[:space:]')" == "0" ]]; then
      printf '\n' >> "$gitignore"
    fi
  fi

  printf '.herdr/\n' >> "$gitignore"
  log "Added .herdr/ to $gitignore"
}

init_layout() {
  local name="${1:-$DEFAULT_LAYOUT}" primary source target target_dir tracked tmp

  validate_layout_name "$name"
  git_root >/dev/null || die "Not inside a Git repository"

  source="$(global_layout_file "$name")"
  validate_layout_file "$source"

  primary="$(primary_repo_root)"
  target_dir="$primary/.herdr/layouts"
  target="$target_dir/$name.json"

  [[ ! -e "$target" ]] || die "Repo-local layout already exists: $target"

  tracked="$(git -C "$primary" ls-files -- '.herdr' '.herdr/**')"
  [[ -z "$tracked" ]] || die ".herdr is already tracked by Git; untrack it before using repo-local hd layouts"

  ensure_herdr_gitignore "$primary"
  mkdir -p "$target_dir"

  tmp="$(mktemp "$target_dir/.${name}.XXXXXX")" || die "Could not create temporary repo-local layout"
  trap 'rm -f "$tmp"' EXIT
  cp "$source" "$tmp" || die "Failed to copy global layout: $source"
  validate_layout_file "$tmp"
  mv "$tmp" "$target"
  trap - EXIT

  log "Initialized repo-local layout:"
  log "  $source"
  log "  → $target"
}

focus_workspace() {
  herdr_json "workspace.focus" workspace focus "$1" >/dev/null \
    || die "Failed to focus workspace: $1"
}

open_linked_checkout() {
  local path="$1" layout="$2" label="$3" primary="$4"
  local created workspace_id tab_id already_open file
  file="$(resolve_layout_file "$layout")"
  validate_layout_file "$file"

  created="$(herdr_json "worktree.open" worktree open \
    --cwd "$primary" --path "$path" --label "$label" --no-focus)" || exit 1

  workspace_id="$(printf '%s\n' "$created" | jq -r '.result.workspace.workspace_id // empty')"
  tab_id="$(printf '%s\n' "$created" | jq -r '.result.tab.tab_id // empty')"
  already_open="$(printf '%s\n' "$created" | jq -r '.result.already_open // false')"
  [[ -n "$workspace_id" ]] || { printf '%s\n' "$created" | jq >&2; die "workspace_id not found in worktree.open response"; }

  if [[ "$already_open" == "true" ]]; then
    focus_workspace "$workspace_id"
    log "Ready: existing workspace ($workspace_id)"
    return
  fi

  [[ -n "$tab_id" ]] || { printf '%s\n' "$created" | jq >&2; die "tab_id not found in worktree.open response"; }
  if ! apply_layout "$tab_id" "$path" "$layout"; then
    warn "Workspace was opened but layout application failed; leaving it intact: $workspace_id"
    exit 1
  fi
  focus_workspace "$workspace_id"
  log "Ready: $label ($workspace_id)"
}

ensure_primary_workspace() {
  local path="$1" layout="$2" label="$3" ws_json workspace_id created tab_id file
  file="$(resolve_layout_file "$layout")"
  validate_layout_file "$file"

  ws_json="$(workspace_list_json)" || die "Could not read Herdr workspace state; refusing to create a duplicate workspace"
  workspace_id="$(find_workspace_id_by_cwd "$ws_json" "$path")"
  if [[ -n "$workspace_id" ]]; then
    focus_workspace "$workspace_id"
    log "Ready: existing workspace ($workspace_id)"
    return
  fi

  created="$(herdr_json "workspace.create" workspace create \
    --cwd "$path" --label "$label" --no-focus)" || exit 1
  workspace_id="$(printf '%s\n' "$created" | jq -r '.result.workspace.workspace_id // empty')"
  tab_id="$(printf '%s\n' "$created" | jq -r '.result.tab.tab_id // empty')"
  [[ -n "$workspace_id" ]] || { printf '%s\n' "$created" | jq >&2; die "workspace_id not found in workspace.create response"; }
  [[ -n "$tab_id" ]] || { printf '%s\n' "$created" | jq >&2; die "tab_id not found in workspace.create response"; }

  if ! apply_layout "$tab_id" "$path" "$layout"; then
    warn "Workspace was created but layout application failed; leaving it intact: $workspace_id"
    exit 1
  fi
  focus_workspace "$workspace_id"
  log "Ready: $label ($workspace_id)"
}

ensure_checkout_workspace() {
  local path="$1" layout="$2" label="$3" worktrees primary
  worktrees="$(git_worktrees_json)"
  primary="$(primary_worktree_path "$worktrees")"
  [[ -n "$primary" ]] || die "Could not determine primary Git worktree"

  if [[ "$path" == "$primary" ]]; then
    ensure_primary_workspace "$path" "$layout" "$label"
  else
    open_linked_checkout "$path" "$layout" "$label" "$primary"
  fi
}

open_current() {
  local layout="$DEFAULT_LAYOUT" root
  while (( $# )); do
    case "$1" in
      --layout)
        [[ $# -ge 2 ]] || die "Usage: hd [--layout NAME]"
        layout="$2"; shift 2 ;;
      *) die "Usage: hd [--layout NAME]" ;;
    esac
  done

  root="$(git_root)" || die "Not inside a Git repository"
  log "Opening current checkout: $root"
  ensure_checkout_workspace "$root" "$layout" "$(basename "$root")"
}

new_worktree() {
  local branch="${1:-}" base="HEAD" layout="$DEFAULT_LAYOUT"
  local root worktrees existing source file created workspace_id tab_id worktree_dir branch_exists=0
  local no_open=0 layout_set=0
  [[ -n "$branch" ]] || die "Usage: hd new <branch> [--base REF] [--layout NAME] [--no-open]"
  shift

  while (( $# )); do
    case "$1" in
      --base)
        [[ $# -ge 2 ]] || die "Usage: hd new <branch> [--base REF] [--layout NAME] [--no-open]"
        base="$2"; shift 2 ;;
      --layout)
        [[ $# -ge 2 ]] || die "Usage: hd new <branch> [--base REF] [--layout NAME] [--no-open]"
        layout="$2"; layout_set=1; shift 2 ;;
      --no-open)
        no_open=1; shift ;;
      *) die "Unexpected argument: $1 (use --base REF / --layout NAME / --no-open)" ;;
    esac
  done

  (( no_open == 0 || layout_set == 0 )) \
    || die "--layout cannot be used with --no-open because no layout is applied"

  root="$(git_root)" || die "Not inside a Git repository"
  validate_branch_name "$branch"

  if (( no_open == 0 )); then
    file="$(resolve_layout_file "$layout")"
    validate_layout_file "$file"
  fi

  worktrees="$(git_worktrees_json)"
  existing="$(worktree_path_for_branch "$worktrees" "$branch")"
  [[ -z "$existing" ]] || die "Worktree for '$branch' already exists: $existing (use: hd open '$branch')"

  source="$(primary_worktree_path "$worktrees")"
  [[ -n "$source" ]] || die "Could not determine primary Git worktree"

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    branch_exists=1
  else
    git rev-parse --verify --quiet "${base}^{commit}" >/dev/null \
      || die "Base does not resolve to a commit: $base"
  fi

  if (( branch_exists )); then
    log "Creating worktree from existing branch: $branch"
    created="$(herdr_json "worktree.create" worktree create \
      --cwd "$source" --branch "$branch" --no-focus)" || exit 1
  else
    log "Creating branch + worktree: $branch (base: $base)"
    created="$(herdr_json "worktree.create" worktree create \
      --cwd "$source" --branch "$branch" --base "$base" --no-focus)" || exit 1
  fi

  workspace_id="$(printf '%s\n' "$created" | jq -r '.result.workspace.workspace_id // empty')"
  tab_id="$(printf '%s\n' "$created" | jq -r '.result.tab.tab_id // empty')"
  worktree_dir="$(printf '%s\n' "$created" | jq -r '.result.worktree.path // .result.workspace.cwd // empty')"
  [[ -n "$workspace_id" ]] || { printf '%s\n' "$created" | jq >&2; die "workspace_id not found in worktree.create response"; }
  [[ -n "$worktree_dir" ]] || { printf '%s\n' "$created" | jq >&2; die "worktree path not found in worktree.create response"; }

  if (( no_open )); then
    if ! herdr_json "workspace.close" workspace close "$workspace_id" >/dev/null; then
      warn "Worktree was created but its Herdr workspace could not be closed: $workspace_id"
      exit 1
    fi
    log "Ready: $branch"
    log "Path:  $worktree_dir"
    log "Herdr workspace left closed."
    return
  fi

  [[ -n "$tab_id" ]] || { printf '%s\n' "$created" | jq >&2; die "tab_id not found in worktree.create response"; }

  if ! apply_layout "$tab_id" "$worktree_dir" "$layout"; then
    warn "Worktree was created but layout application failed; leaving it intact: $worktree_dir"
    exit 1
  fi

  focus_workspace "$workspace_id"
  log "Ready: $branch"
  log "Path:  $worktree_dir"
}

open_worktree() {
  local branch="${1:-}" layout="$DEFAULT_LAYOUT" root worktrees path file
  [[ -n "$branch" ]] || die "Usage: hd open <branch> [--layout NAME]"
  shift

  while (( $# )); do
    case "$1" in
      --layout)
        [[ $# -ge 2 ]] || die "Usage: hd open <branch> [--layout NAME]"
        layout="$2"; shift 2 ;;
      *) die "Unexpected argument: $1 (use --layout NAME)" ;;
    esac
  done

  file="$(resolve_layout_file "$layout")"
  validate_layout_file "$file"
  root="$(git_root)" || die "Not inside a Git repository"
  validate_branch_name "$branch"
  worktrees="$(git_worktrees_json)"
  path="$(worktree_path_for_branch "$worktrees" "$branch")"
  [[ -n "$path" ]] || die "No worktree exists for '$branch' (use: hd new '$branch')"

  log "Opening worktree: $branch"
  ensure_checkout_workspace "$path" "$layout" "$branch"
}

list_workspaces() {
  local json_output="${1:-0}"
  local worktrees ws_json panes_json herdr_known=1 panes_known=1
  local workspaces='[]' panes='[]' result count i branch path status agent_summary

  git_root >/dev/null || die "Not inside a Git repository"
  worktrees="$(git_worktrees_json)"

  if ws_json="$(workspace_list_json)"; then
    workspaces="$(printf '%s\n' "$ws_json" | jq -c '.result.workspaces')"
    if panes_json="$(pane_list_json)"; then
      panes="$(printf '%s\n' "$panes_json" | jq -c '.result.panes')"
    else
      panes_known=0
      warn "Could not read Herdr pane state; AGENT data will show as unknown"
    fi
  else
    herdr_known=0
    panes_known=0
    warn "Could not read Herdr workspace state; HERDR/AGENT data will show as unknown"
  fi

  result="$(jq -nc \
    --argjson worktrees "$worktrees" \
    --argjson workspaces "$workspaces" \
    --argjson panes "$panes" \
    --argjson herdr_known "$herdr_known" \
    --argjson panes_known "$panes_known" '
    {
      schema_version: 1,
      worktrees: (
        $worktrees
        | to_entries
        | map(
            .key as $index
            | .value as $wt
            | ($workspaces
               | map(select((.cwd // "") == ($wt.path // "")))
               | .[0].workspace_id // null
              ) as $workspace_id
            | {
                branch: ($wt.branch // "(detached)"),
                path: $wt.path,
                primary: ($index == 0),
                herdr: (
                  if $herdr_known == 0 then "unknown"
                  elif $workspace_id != null then "open"
                  else "closed"
                  end
                ),
                workspace_id: $workspace_id,
                agents_known: (
                  if $herdr_known == 0 then false
                  elif $workspace_id == null then true
                  else ($panes_known == 1)
                  end
                ),
                agents: (
                  if $herdr_known == 1 and $workspace_id != null and $panes_known == 1 then
                    [
                      $panes[]
                      | select((.workspace_id // "") == $workspace_id)
                      | select((.agent // "") != "" or (.display_agent // "") != "")
                      | {
                          pane_id: .pane_id,
                          agent: (.agent // null),
                          display_agent: (.display_agent // .agent // null),
                          status: (.agent_status // "unknown")
                        }
                    ]
                  else
                    []
                  end
                )
              }
          )
      )
    }
  ')" || die "Failed to build workspace status"

  if (( json_output )); then
    printf '%s\n' "$result" | jq .
    return
  fi

  printf '\n%-28s %-8s %-28s %s\n' "BRANCH" "HERDR" "AGENT" "PATH"
  printf '%-28s %-8s %-28s %s\n' "----------------------------" "--------" "----------------------------" "----"
  count="$(printf '%s\n' "$result" | jq '.worktrees | length')"
  for (( i=0; i<count; i++ )); do
    branch="$(printf '%s\n' "$result" | jq -r ".worktrees[$i].branch")"
    path="$(printf '%s\n' "$result" | jq -r ".worktrees[$i].path")"
    status="$(printf '%s\n' "$result" | jq -r ".worktrees[$i].herdr")"
    agent_summary="$(printf '%s\n' "$result" | jq -r ".worktrees[$i] |
      if .herdr == \"unknown\" or (.agents_known | not) then \"?\"
      elif (.agents | length) == 0 then \"-\"
      else
        [.agents[] | ((.display_agent // .agent // \"agent\") + \":\" + (.status // \"unknown\"))]
        | unique
        | join(\",\")
      end
    ")"
    printf '%-28s %-8s %-28s %s\n' "$branch" "$status" "$agent_summary" "$path"
  done
  printf '\n'
}

confirm_action() {
  local prompt="$1" answer
  printf '%s' "$prompt" >&2
  if ! IFS= read -r -s -n 1 answer; then
    printf '\n' >&2
    return 1
  fi
  printf '\n' >&2
  case "$answer" in
    y|Y) return 0 ;;
    *) return 1 ;;
  esac
}

resolve_close_context() {
  local response workspace_id pane_id panes_json session_matches ws_json root matches count

  if [[ -n "${HERDR_PANE_ID:-}" ]]; then
    if response="$(herdr pane current --current 2>/dev/null)"; then
      if printf '%s\n' "$response" | jq -e '.error == null and .result.pane.workspace_id != null and .result.pane.pane_id != null' >/dev/null 2>&1; then
        workspace_id="$(printf '%s\n' "$response" | jq -r '.result.pane.workspace_id')"
        pane_id="$(printf '%s\n' "$response" | jq -r '.result.pane.pane_id')"
        jq -nc --arg workspace "$workspace_id" --arg pane "$pane_id"           '{workspace_id:$workspace,pane_id:$pane,source:"pane_current"}'
        return
      fi
    fi
  fi

  if [[ -n "${CODEX_THREAD_ID:-}" ]]; then
    if panes_json="$(pane_list_json 2>/dev/null)"; then
      session_matches="$(printf '%s\n' "$panes_json" | jq -c --arg session "$CODEX_THREAD_ID" '
        [
          .result.panes[]
          | select((.pane_id // "") != "" and (.workspace_id // "") != "")
          | select(
              ((.agent // "") | ascii_downcase) == "codex"
              or ((.display_agent // "") | ascii_downcase) == "codex"
            )
          | select(
              (.agent_session.agent // "codex" | ascii_downcase) == "codex"
              and (.agent_session.value // "") == $session
            )
        ]
      ')"
      count="$(printf '%s\n' "$session_matches" | jq 'length')"
      if (( count == 1 )); then
        workspace_id="$(printf '%s\n' "$session_matches" | jq -r '.[0].workspace_id')"
        pane_id="$(printf '%s\n' "$session_matches" | jq -r '.[0].pane_id')"
        jq -nc --arg workspace "$workspace_id" --arg pane "$pane_id"           '{workspace_id:$workspace,pane_id:$pane,source:"codex_thread"}'
        return
      fi
    fi
  fi

  ws_json="$(workspace_list_json)" || return 1

  if [[ -n "${HERDR_WORKSPACE_ID:-}" ]]; then
    workspace_id="$(printf '%s\n' "$ws_json" | jq -r --arg workspace "$HERDR_WORKSPACE_ID" '
      .result.workspaces
      | map(select((.workspace_id // "") == $workspace))
      | .[0].workspace_id // empty
    ')"
    if [[ -n "$workspace_id" ]]; then
      jq -nc --arg workspace "$workspace_id"         '{workspace_id:$workspace,pane_id:null,source:"workspace_env"}'
      return
    fi
  fi

  root="$(git_root 2>/dev/null || pwd -P)"
  matches="$(printf '%s\n' "$ws_json" | jq -c --arg cwd "$root" '
    [.result.workspaces[] | select((.cwd // "") == $cwd)]
  ')"
  count="$(printf '%s\n' "$matches" | jq 'length')"
  if (( count == 1 )); then
    workspace_id="$(printf '%s\n' "$matches" | jq -r '.[0].workspace_id')"
    jq -nc --arg workspace "$workspace_id"       '{workspace_id:$workspace,pane_id:null,source:"cwd"}'
    return
  fi

  return 1
}

close_agent_pane() {
  local pane_id="$1" response code

  if response="$(herdr pane close "$pane_id")"; then
    json_check_error "$response" "pane.close" || return 1
    return
  fi

  if ! printf '%s\n' "$response" | jq -e . >/dev/null 2>&1; then
    printf '[hd] ERROR: pane.close command failed\n' >&2
    [[ -n "$response" ]] && printf '%s\n' "$response" >&2
    return 1
  fi

  code="$(printf '%s\n' "$response" | jq -r '.error.code // empty')"
  case "$code" in
    pane_not_found|workspace_not_found)
      return 0
      ;;
    *)
      printf '[hd] ERROR: pane.close failed\n' >&2
      printf '%s\n' "$response" | jq '.error // .' >&2
      return 1
      ;;
  esac
}

cleanup_workspace_agents() {
  local workspace_id="$1" skip_pane_id="${2:-}" panes pane_ids pane_id

  panes="$(herdr_json "pane.list" pane list --workspace "$workspace_id")" || return 1
  if ! printf '%s\n' "$panes" | jq -e '.result.panes | type == "array"' >/dev/null 2>&1; then
    warn "Unexpected pane.list response schema"
    printf '%s\n' "$panes" | jq >&2
    return 1
  fi

  # Cleanup policy currently targets Codex only.
  pane_ids="$(printf '%s\n' "$panes" | jq -r --arg workspace "$workspace_id" --arg skip_pane "$skip_pane_id" '
    .result.panes[]
    | select((.workspace_id // "") == $workspace)
    | select((.pane_id // "") != "")
    | select((.pane_id // "") != $skip_pane)
    | select(
        ((.agent // "") | ascii_downcase) == "codex"
        or ((.display_agent // "") | ascii_downcase) == "codex"
      )
    | .pane_id
  ')"

  [[ -n "$pane_ids" ]] || return 0

  while IFS= read -r pane_id; do
    [[ -n "$pane_id" ]] || continue
    log "Closing workspace agent pane: $pane_id (codex)"
    close_agent_pane "$pane_id" || return 1
  done <<< "$pane_ids"
}

close_workspace() {
  local assume_yes="${1:-0}" context workspace_id caller_pane_id source response code

  context="$(resolve_close_context)" || die "Could not resolve the current Herdr workspace"
  workspace_id="$(printf '%s\n' "$context" | jq -r '.workspace_id // empty')"
  caller_pane_id="$(printf '%s\n' "$context" | jq -r '.pane_id // empty')"
  source="$(printf '%s\n' "$context" | jq -r '.source // "unknown"')"
  [[ -n "$workspace_id" ]] || die "Could not resolve the current Herdr workspace"

  log "Close current Herdr workspace?"
  log "  workspace: $workspace_id"
  log "  cwd: ${PWD:-unknown}"
  [[ "$source" == "pane_current" ]] || warn "Resolved workspace via $source because pane identity was unavailable."
  if (( assume_yes == 0 )); then
    if ! confirm_action "Continue? [y/N] "; then
      log "Cancelled"
      return
    fi
  fi

  cleanup_workspace_agents "$workspace_id" "$caller_pane_id" || {
    warn "Workspace agent cleanup failed; workspace was left open."
    return 1
  }

  if response="$(herdr workspace close "$workspace_id")"; then
    json_check_error "$response" "workspace.close" || return 1
    return
  fi

  if ! printf '%s\n' "$response" | jq -e . >/dev/null 2>&1; then
    printf '[hd] ERROR: workspace.close command failed\n' >&2
    [[ -n "$response" ]] && printf '%s\n' "$response" >&2
    return 1
  fi

  code="$(printf '%s\n' "$response" | jq -r '.error.code // empty')"
  if [[ "$code" == "workspace_not_found" ]]; then
    log "Workspace already closed after agent cleanup."
    return
  fi
  if [[ "$code" != "workspace_group_close_required" ]]; then
    printf '[hd] ERROR: workspace.close failed\n' >&2
    printf '%s\n' "$response" | jq '.error // .' >&2
    return 1
  fi

  warn "This workspace has linked worktree workspaces."
  warn "Closing it requires closing the entire Herdr group."
  if (( assume_yes == 0 )); then
    if ! confirm_action "Close the whole group? [y/N] "; then
      log "Cancelled"
      return
    fi
  fi

  herdr_json "workspace.close" workspace close "$workspace_id" --group >/dev/null \
    || return 1
}

remove_worktree() {
  local target="${1:-}" worktrees primary selected branch path ws_json workspace_id count choice candidates
  git_root >/dev/null || die "Not inside a Git repository"
  worktrees="$(git_worktrees_json)"
  primary="$(primary_worktree_path "$worktrees")"
  [[ -n "$primary" ]] || die "No Git worktrees found"

  if [[ -z "$target" ]]; then
    candidates="$(printf '%s\n' "$worktrees" | jq --arg primary "$primary" '[.[] | select(.path != $primary)]')"
    count="$(printf '%s\n' "$candidates" | jq 'length')"
    [[ "$count" -gt 0 ]] || die "No linked worktrees to remove"
    log "Select a linked worktree to remove:"
    local i
    for (( i=0; i<count; i++ )); do
      printf '  %d) %-28s %s\n' "$((i+1))" \
        "$(printf '%s\n' "$candidates" | jq -r ".[$i].branch // \"(detached)\"")" \
        "$(printf '%s\n' "$candidates" | jq -r ".[$i].path")"
    done
    printf 'Selection: '
    read -r choice || die "No selection provided"
    case "$choice" in ''|*[!0-9]*) die "Invalid selection" ;; esac
    (( choice >= 1 && choice <= count )) || die "Invalid selection"
    selected="$(printf '%s\n' "$candidates" | jq -c ".[$((choice-1))]")"
  else
    selected="$(printf '%s\n' "$worktrees" | jq -c --arg target "$target" '
      [.[] | select((.branch // "") == $target or .path == $target)] | .[0] // empty
    ')"
    [[ -n "$selected" ]] || die "Worktree not found: $target"
  fi

  branch="$(printf '%s\n' "$selected" | jq -r '.branch // "(detached)"')"
  path="$(printf '%s\n' "$selected" | jq -r '.path')"
  [[ "$path" != "$primary" ]] || die "Refusing to remove the primary worktree"

  ws_json="$(workspace_list_json)" || die "Could not read Herdr workspace state; refusing removal to avoid desynchronizing Herdr and Git"
  workspace_id="$(find_workspace_id_by_cwd "$ws_json" "$path")"

  log "Removing: $branch"
  log "Path:     $path"
  if [[ -n "$workspace_id" ]]; then
    log "Via Herdr workspace: $workspace_id"
    herdr_json "worktree.remove" worktree remove --workspace "$workspace_id" >/dev/null \
      || exit 1
  else
    log "No open Herdr workspace; removing with Git"
    git worktree remove "$path"
  fi
  log "Removed worktree. Branch was NOT deleted: $branch"
}

herdr_help_has_subcommand() {
  local help_text="$1" subcommand="$2"
  printf '%s\n' "$help_text" | grep -Eq "(^|[[:space:]])${subcommand}([[:space:]]|$)"
}

doctor_herdr_capabilities() {
  local pane_help workspace_help worktree_help api_schema capability_missing=0
  local schema_known=0

  pane_help="$(herdr pane --help 2>&1 || true)"
  workspace_help="$(herdr workspace --help 2>&1 || true)"
  worktree_help="$(herdr worktree --help 2>&1 || true)"

  if api_schema="$(herdr api schema --json 2>/dev/null)"; then
    schema_known=1
  else
    api_schema=""
  fi

  printf '\nHerdr capabilities:\n'

  if herdr_help_has_subcommand "$pane_help" "list"; then
    printf '%-22s %s\n' "pane list" "ok"
  else
    printf '%-22s %s\n' "pane list" "MISSING"
    capability_missing=1
  fi

  if herdr_help_has_subcommand "$pane_help" "close"; then
    printf '%-22s %s\n' "pane close" "ok"
  else
    printf '%-22s %s\n' "pane close" "MISSING"
    capability_missing=1
  fi

  if herdr_help_has_subcommand "$pane_help" "current"; then
    printf '%-22s %s\n' "pane current" "ok"
  else
    printf '%-22s %s\n' "pane current" "MISSING"
    capability_missing=1
  fi

  if herdr_help_has_subcommand "$workspace_help" "close"; then
    printf '%-22s %s\n' "workspace close" "ok"
  else
    printf '%-22s %s\n' "workspace close" "MISSING"
    capability_missing=1
  fi

  local subcommand
  for subcommand in create open remove; do
    if herdr_help_has_subcommand "$worktree_help" "$subcommand"; then
      printf '%-22s %s\n' "worktree $subcommand" "ok"
    else
      printf '%-22s %s\n' "worktree $subcommand" "MISSING"
      capability_missing=1
    fi
  done

  if (( schema_known )); then
    if printf '%s\n' "$api_schema" | grep -Fq '"layout.apply"'; then
      printf '%-22s %s\n' "layout.apply" "ok"
    else
      printf '%-22s %s\n' "layout.apply" "MISSING"
      capability_missing=1
    fi
    if printf '%s\n' "$api_schema" | grep -Fq '"layout.export"'; then
      printf '%-22s %s\n' "layout.export" "ok"
    else
      printf '%-22s %s\n' "layout.export" "MISSING"
      capability_missing=1
    fi
  else
    printf '%-22s %s\n' "layout.apply" "unknown (API schema unavailable)"
    printf '%-22s %s\n' "layout.export" "unknown (API schema unavailable)"
  fi

  (( capability_missing == 0 ))
}

doctor() {
  local tool root found_missing=0 capability_missing=0 sock any=0 f
  printf 'hd %s\n\n' "$HD_VERSION"
  for tool in git herdr jq python3; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf '%-18s %s\n' "$tool" "$(command -v "$tool")"
    else
      printf '%-18s %s\n' "$tool" "MISSING"
      found_missing=1
    fi
  done
  sock="$(socket_path)"
  [[ -S "$sock" ]] && printf '%-18s %s\n' "socket" "$sock" || printf '%-18s %s\n' "socket" "$sock (not found)"
  printf '%-18s %s\n' "layout dir" "$LAYOUT_DIR"
  if command -v git >/dev/null 2>&1 && root="$(git_root 2>/dev/null)"; then
    printf '%-18s %s\n' "repo" "$root"
  else
    printf '%-18s %s\n' "repo" "(not in a Git repo)"
  fi
  printf '\nLayouts:\n'
  if [[ -d "$LAYOUT_DIR" ]]; then
    for f in "$LAYOUT_DIR"/*.json; do
      [[ -e "$f" ]] || continue
      any=1
      printf '  - %s\n' "$(basename "$f" .json)"
    done
  fi
  (( any )) || printf '  (none)\n'
  if command -v herdr >/dev/null 2>&1; then
    doctor_herdr_capabilities || capability_missing=1
  fi
  if command -v git >/dev/null 2>&1 && git_root >/dev/null 2>&1; then
    printf '\nStale worktree metadata (dry-run only):\n'
    git worktree prune --dry-run --verbose 2>/dev/null || git worktree prune -n -v 2>/dev/null || true
  fi
  (( found_missing == 0 && capability_missing == 0 )) || return 1
}

usage() {
  cat <<EOF
hd $HD_VERSION

Usage:
  hd [--layout NAME]                    Ensure/focus current checkout workspace
  hd new <branch> [--base REF] [--layout NAME] [--no-open]
                                        Create a new worktree; keep workspace closed with --no-open
  hd open <branch> [--layout NAME]      Open an existing worktree
  hd list [--json]                      List checkouts, Herdr state, and agents
  hd close [-y|--yes]                   Close current Herdr workspace
  hd rm [branch|path]                   Remove linked worktree; never branch
  hd layout save [name]                 Save current Herdr tab layout globally
  hd layout init [name]                 Copy global layout into repo-local .herdr
  hd doctor                             Check dependencies/config/stale metadata
  hd help

Rules:
  hd        never creates a Git worktree; it ensures the current checkout is open.
  hd new    requires that the branch is not already checked out in a worktree.
  --no-open creates the worktree but leaves its Herdr workspace closed.
  hd open   requires that the branch already has a Git worktree checkout.
  hd close  closes Herdr state only; -y/--yes skips close confirmations.
  --layout  is a bootstrap layout only; existing Herdr workspaces are focused unchanged.
  Layouts   resolve repo/.herdr/layouts first, then ~/.config/herdr/layouts.

Environment:
  HD_DEFAULT_LAYOUT                     Default layout name (default: dev)
  HD_LAYOUT_DIR                         Global layout directory
EOF
}

main() {
  local cmd
  if (( $# == 0 )) || [[ "${1:-}" == "--layout" ]]; then
    require_deps
    open_current "$@"
    return
  fi

  cmd="$1"; shift
  case "$cmd" in
    help|-h|--help)
      (( $# == 0 )) || die "Usage: hd help"
      usage
      ;;
    --version)
      (( $# == 0 )) || die "Usage: hd --version"
      printf 'hd %s\n' "$HD_VERSION"
      ;;
    doctor)
      (( $# == 0 )) || die "Usage: hd doctor"
      doctor
      ;;
    new)
      require_deps
      new_worktree "$@"
      ;;
    open)
      require_deps
      open_worktree "$@"
      ;;
    list)
      local list_json=0
      while (( $# )); do
        case "$1" in
          --json) list_json=1; shift ;;
          *) die "Usage: hd list [--json]" ;;
        esac
      done
      require_deps
      list_workspaces "$list_json"
      ;;
    close)
      local close_yes=0
      while (( $# )); do
        case "$1" in
          -y|--yes) close_yes=1; shift ;;
          *) die "Usage: hd close [-y|--yes]" ;;
        esac
      done
      need herdr
      need jq
      close_workspace "$close_yes"
      ;;
    rm)
      (( $# <= 1 )) || die "Usage: hd rm [branch|path]"
      require_deps
      remove_worktree "${1:-}"
      ;;
    layout)
      case "${1:-}" in
        save)
          shift
          (( $# <= 1 )) || die "Usage: hd layout save [name]"
          require_deps
          save_layout "${1:-$DEFAULT_LAYOUT}"
          ;;
        init)
          shift
          (( $# <= 1 )) || die "Usage: hd layout init [name]"
          need git
          need jq
          init_layout "${1:-$DEFAULT_LAYOUT}"
          ;;
        *) die "Usage: hd layout <save|init> [name]" ;;
      esac
      ;;
    *) die "Unknown command: $cmd (try: hd help)" ;;
  esac
}

main "$@"
